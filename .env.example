# משחק אונליין. בלי הערכים האלה האפליקציה עובדת במצב מקומי בלבד.
#
# מפרויקט Supabase: Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── בצד השרת (Supabase → Edge Functions → Secrets), לא כאן: ──
# SUPABASE_SERVICE_ROLE_KEY   מונפק אוטומטית
# ALLOWED_ORIGIN              מקור ה-CORS של האתר, למשל https://tabu.example.com
# TURN_KEY_ID / TURN_KEY_API_TOKEN   מ-Cloudflare Realtime TURN (1,000GB חינם בחודש)
